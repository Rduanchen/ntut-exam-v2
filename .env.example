# Docker Compose: copy to .env and set ADMIN_TOKEN before starting.
ADMIN_PORT=3000
USER_PORT=3001
FRONTEND_PORT=5173
PISTON_PORT=2000
ADMIN_TOKEN=

# Keep the admin API and frontend on the host unless a protected admin network is configured.
ADMIN_BIND_HOST=127.0.0.1
FRONTEND_BIND_HOST=127.0.0.1
VITE_BACKEND_URL=http://localhost:3000
